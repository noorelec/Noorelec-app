rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Numéros TVA enregistrés : lecture / écriture interdites côté client (Cloud Functions uniquement)
    match /vatRegistrations/{vatId} {
      allow read, write: if false;
    }

    // Profil abonnement / essai : le client ne peut pas se donner un essai ou un paiement actif
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Réglages entreprise (déjà utilisés par l’app)
    match /settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Collections métier existantes
    match /devis/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /clients/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /products/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Prix / temps MO personnalisés par électricien (ne modifie pas la collection products)
    match /userProductOverrides/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
